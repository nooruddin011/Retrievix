# Copy to .env. Values already set in the real environment always win over this file.
# Quote values that contain '#' or trailing spaces.

# --- Vector store ---
QDRANT_URL=http://localhost:6333        # ":memory:" for ephemeral local mode, "path:./qdrant" for on-disk
QDRANT_API_KEY=
QDRANT_WAIT_S=30                        # how long to wait for Qdrant at start-up
COLLECTION=tech_docs

# --- Encoders: "hf" (PyTorch/Transformers) or "hash" (offline stand-in for CI/demos) ---
ENCODER_BACKEND=hf
DENSE_MODEL=BAAI/bge-small-en-v1.5      # or a path to your fine-tuned model
DENSE_POOLING=cls
DENSE_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
SPARSE_MODEL=naver/splade-cocondenser-ensembledistil   # or your fine-tuned SPLADE
ROUTER_MODEL=                           # path to a fine-tuned router classifier; empty = heuristic router
EMBED_CACHE_SIZE=512                    # cached query embeddings (0 disables)

# --- Agent LLM (empty key = deterministic offline fallback) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_S=45
MAX_REWRITES=2
MAX_SUB_QUERIES=4

# --- Tool fallbacks ---
GITHUB_REPO=                            # e.g. owner/repo
GITHUB_TOKEN=
CODE_ROOT=                              # local repo to search when docs fall short

# --- Service ---
APP_NAME="Hybrid Search"                # shown in the UI header and page title
DOCS_DIR=data/docs
EVAL_FILE=data/eval/queries.jsonl
AUTO_INGEST=1                           # sync the index with DOCS_DIR at start-up (incremental)
SERVE_UI=1                              # serve the web UI at /
READ_ONLY=0                             # 1 = disable uploads, edits, deletes and re-indexing
LOG_LEVEL=INFO

# --- Security & limits ---
API_KEY=                                # if set, clients must send X-API-Key (the UI asks for it)
CORS_ORIGINS=                           # comma-separated; only needed if the UI is hosted elsewhere
RATE_LIMIT_PER_MIN=120                  # per client; the agent costs 5, re-index/eval 20. 0 disables
TRUST_PROXY=0                           # 1 = use X-Forwarded-For for client identity (behind a proxy you control)
MAX_QUERY_CHARS=2000
MAX_DOC_BYTES=524288
MAX_DOCUMENTS=500
